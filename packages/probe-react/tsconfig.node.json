/* Ficheros de configuración del paquete (se ejecutan en Node, no en el navegador).
   El código de la sonda lo cubre tsconfig.json. */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "types": [],
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true
  },
  "include": ["vite.config.ts"]
}
