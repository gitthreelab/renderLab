/* Tests e2e de Playwright (e2e/**): corren en Node, pero los callbacks de
   page.evaluate y addInitScript se ejecutan en el navegador, de ahí DOM. */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": ["e2e"]
}
