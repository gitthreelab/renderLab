{
  "name": "ng-host",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "generate:routes": "node scripts/generate-recipe-routes.mts",
    "dev": "pnpm generate:routes && ng serve",
    "build": "pnpm generate:routes && ng build --configuration development",
    "typecheck": "pnpm generate:routes && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@types/node": "^24.19.0"
  }
}
