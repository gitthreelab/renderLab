/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "outDir": "./out-tsc/app",
    /* Incluye recipes/ (fuera de ng-host). Sus imports bare se resuelven con el
       publicHoistPattern de pnpm-workspace.yaml. */
    "rootDir": "../..",
    "types": []
  },
  /* Los paquetes del workspace se consumen como fuente TS: el compilador de
     Angular exige que estén en el programa. */
  "include": [
    "src/**/*.ts",
    "../../recipes/*/angular/**/*.ts",
    "../../packages/probe-ng/src/**/*.ts",
    "../../packages/protocol/src/**/*.ts"
  ],
  "exclude": ["../../packages/*/src/**/*.test.ts"]
}
